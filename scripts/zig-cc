#!/usr/bin/env python3
"""Invoke zig cc, dropping rustc linker flags zig does not accept."""

import os
import sys

SKIP = {
    "--fix-cortex-a53-843419",
    "-Wl,--fix-cortex-a53-843419",
}

if len(sys.argv) < 2:
    sys.stderr.write("usage: zig-cc <zig-target> [cc-args...]\n")
    sys.exit(2)

zig_target = sys.argv[1]
args = [arg for arg in sys.argv[2:] if arg not in SKIP]
os.execvp("zig", ["zig", "cc", "-target", zig_target, *args])
